<script>
  function initPortfolioInteractions() {
    // 1. Profile Card Tabs (README vs Generative Crystal)
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('[data-profile-tab]');
    const readmePanel = document.getElementById('tab-panel-readme');
    const crystalPanel = document.getElementById('tab-panel-crystal');

    tabBtns.forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const target = btn.dataset.profileTab;
        tabBtns.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('active', active);
          b.setAttribute('aria-selected', String(active));
        });
        if (readmePanel && crystalPanel) {
          readmePanel.hidden = target !== 'readme';
          crystalPanel.hidden = target !== 'crystal';
        }
      });
    });

    // 2. Category Filters + Tech Stack Row Jump
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.project[data-category]');
    const liveStatus = document.getElementById('filter-live-status');

    function applyCategoryFilter(category: string) {
      let visibleCount = 0;
      filterBtns.forEach((b) => {
        const active = b.dataset.filter === category;
        b.classList.toggle('active', active);
        b.setAttribute('aria-pressed', String(active));
      });
      cards.forEach((card) => {
        const show = category === 'all' || card.dataset.category === category;
        card.hidden = !show;
        if (show) visibleCount++;
      });
      if (liveStatus) {
        liveStatus.textContent = `${visibleCount} projects shown for category ${category}`;
      }
    }

    filterBtns.forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        applyCategoryFilter(btn.dataset.filter ?? 'all');
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-skill-jump]').forEach((rowBtn) => {
      if (rowBtn.dataset.bound === 'true') return;
      rowBtn.dataset.bound = 'true';
      rowBtn.addEventListener('click', () => {
        const cat = (rowBtn.getAttribute('data-skill-jump') ?? 'all').toLowerCase();
        applyCategoryFilter(cat);
        document.getElementById('projects')?.scrollIntoView({ behavior: 'smooth' });
      });
    });

    // 3. Alice_Ai Interactive Scripted Chat (Chips + Free-text Input)
    const userBubble = document.getElementById('alice-user-msg');
    const replyBubble = document.getElementById('alice-bot-reply');
    const aliceForm = document.getElementById('alice-inline-form') as HTMLFormElement | null;
    const aliceInput = document.getElementById('alice-inline-input') as HTMLInputElement | null;

    document.querySelectorAll<HTMLButtonElement>('[data-alice-ask]').forEach((chip) => {
      if (chip.dataset.bound === 'true') return;
      chip.dataset.bound = 'true';
      chip.addEventListener('click', () => {
        if (userBubble && chip.dataset.aliceChip) {
          userBubble.textContent = chip.dataset.aliceChip;
        }
        if (replyBubble) {
          replyBubble.textContent = chip.dataset.aliceAsk ?? '';
        }
      });
    });

    if (aliceForm && aliceInput && aliceForm.dataset.bound !== 'true') {
      aliceForm.dataset.bound = 'true';
      aliceForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = aliceInput.value.trim();
        if (!q) return;
        if (userBubble) userBubble.textContent = q;

        const intents = (window as unknown as {
          __ALICE_INTENTS__?: Array<{
            keys: string[];
            answer: { en: string; id: string };
          }>;
          __PORTFOLIO_LOCALE__?: 'en' | 'id';
        }).__ALICE_INTENTS__ ?? [];
        const loc = (window as unknown as { __PORTFOLIO_LOCALE__?: 'en' | 'id' }).__PORTFOLIO_LOCALE__ ?? 'en';
        const lower = q.toLowerCase();

        if (lower.includes('wonderland') || lower.includes('rabbit') || lower.includes('kelinci') || lower.includes('tea party')) {
          const wlBtn = document.querySelector<HTMLElement>('[data-wonderland-toggle]');
          wlBtn?.click();
          const isNowWl = document.documentElement.dataset.wonderland === 'on';
          if (replyBubble) {
            replyBubble.textContent =
              loc === 'id'
                ? isNowWl
                  ? 'Selamat datang di Negeri Ajaib! Tema Alice in Wonderland sekarang AKTIF. Ketik "wonderland" lagi atau klik tombol ♠ untuk kembali.'
                  : 'Kembali dari Negeri Ajaib ke tema Snowfield Alice Blue.'
                : isNowWl
                  ? 'Welcome down the Rabbit Hole! Alice in Wonderland theme is now ON. Type "wonderland" again or click the ♠ button to toggle it OFF.'
                  : 'Returned from Wonderland back to the Alice Blue Snowfield theme.';
          }
          aliceInput.value = '';
          return;
        }

        const found = intents.find((item) =>
          item.keys.some((k) => lower.includes(k))
        );

        if (replyBubble) {
          replyBubble.textContent = found
            ? found.answer[loc]
            : loc === 'id'
              ? 'Ini pratinjau berskrip. Coba tanya tentang "stack", "pos", "laravel", atau "kontak".'
              : 'This is a scripted preview. Try asking about "stack", "pos", "laravel", or "contact".';
        }
        aliceInput.value = '';
      });
    }

    // 4. Copy Email Button
    const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
    const copyFeedback = document.getElementById('copy-feedback');
    if (copyBtn && copyBtn.dataset.bound !== 'true') {
      copyBtn.dataset.bound = 'true';
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.dataset.copyEmail ?? '';
        try {
          await navigator.clipboard.writeText(email);
          if (copyFeedback) copyFeedback.textContent = 'Copied!';
          setTimeout(() => {
            if (copyFeedback) copyFeedback.textContent = '';
          }, 2200);
        } catch {
          if (copyFeedback) copyFeedback.textContent = email;
        }
      });
    }

    // 5. Contact Form Validation & Feedback
    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    const notice = document.getElementById('formNotice');
    if (form && form.dataset.bound !== 'true') {
      form.dataset.bound = 'true';
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = String(data.get('name') ?? '').trim();
        const email = String(data.get('email') ?? '').trim();
        const message = String(data.get('message') ?? '').trim();

        if (!name || !email.includes('@') || message.length < 10) {
          if (notice) {
            notice.textContent =
              document.documentElement.lang === 'id'
                ? 'Mohon isi nama, email yang valid, dan pesan minimal 10 karakter.'
                : 'Please enter your name, a valid email address, and a message of at least 10 characters.';
          }
          return;
        }

        if (notice) {
          notice.textContent =
            document.documentElement.lang === 'id'
              ? `Terima kasih, ${name}! Simulasi antarmuka berhasil; tambahkan PUBLIC_WEB3FORMS_KEY di Secrets GitHub untuk pengiriman langsung.`
              : `Thank you, ${name}! Interface validation passed; add PUBLIC_WEB3FORMS_KEY in GitHub Secrets to enable live email delivery.`;
        }
        form.reset();
      });
    }
  }

  function syncStatusBadge() {
    const badge = document.querySelector<HTMLElement>('[data-status-badge]');
    if (!badge) return;
    const isWl = document.documentElement.dataset.wonderland === 'on';
    badge.textContent = isWl
      ? badge.dataset.wonderlandText ?? 'IN WONDERLAND ♠'
      : badge.dataset.defaultText ?? 'BUILDING';
  }

  initPortfolioInteractions();
  syncStatusBadge();
  document.addEventListener('astro:page-load', () => {
    initPortfolioInteractions();
    syncStatusBadge();
  });
  window.addEventListener('wonderland:change', syncStatusBadge);
</script>

