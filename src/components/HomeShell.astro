---
import { getCollection } from 'astro:content';
import Crystal from './Crystal.astro';
import { getGitHubSnapshot } from '../data/github';
import aliceIntents from '../data/alice-intents.json';
import { withBase, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const isId = locale === 'id';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const gh = await getGitHubSnapshot();
const projectBase = isId ? '/id/projects/' : '/projects/';

const copy = {
  kicker: isId ? 'PORTOFOLIO DEVELOPER · 2026' : 'DEVELOPER PORTFOLIO · 2026',
  h1Before: isId ? 'Membangun ide menjadi ' : 'Turning ideas into ',
  h1Accent: isId ? 'solusi digital.' : 'digital solutions.',
  heroLead: isId
    ? 'Saya Snowsant1999, developer yang senang mengeksplorasi web, aplikasi desktop, kecerdasan buatan, blockchain, dan cloud computing melalui proyek nyata.'
    : 'I am Snowsant1999, a software developer exploring web applications, desktop systems, artificial intelligence, blockchain, and cloud computing through real repositories.',
  ctaProjects: isId ? 'Lihat Proyek' : 'View Projects',
  ctaContact: isId ? 'Hubungi' : 'Contact Me',
  ctaCv: isId ? 'Unduh CV' : 'Download CV',
  metaRepos: isId ? 'Repositori unggulan' : 'Featured repositories',
  metaAreas: isId ? 'Area teknologi' : 'Technology areas',
  metaGithub: isId ? 'Total repositori publik' : 'Public repositories',
  profileSub: 'Developer · Indonesia',
  statusLabel: 'BUILDING',
  tabReadme: '~/profile/README.md',
  tabCrystal: isId ? 'Kristal Seed' : 'Crystal Seed',
  viewGithub: isId ? 'Lihat GitHub ↗' : 'View GitHub ↗',
  sec1Eyebrow: '01 / SELECTED WORK',
  sec1Title: isId ? 'Proyek pilihan' : 'Selected projects',
  sec1Lead: isId
    ? 'Enam repositori dari berbagai area teknologi. Buka halaman detail atau repositori untuk memeriksa kode.'
    : 'Six repositories across five technology domains. Open the case study page or repository to inspect the work.',
  filterAll: isId ? 'Semua' : 'All',
  openDetail: isId ? 'Detail proyek' : 'Case study',
  openRepo: isId ? 'Repositori' : 'Repository',
  visualNote: isId
    ? 'CATATAN: VISUAL DI ATAS ADALAH SIMULASI KONSEP INTERAKTIF, BUKAN SCREENSHOT PRODUK ASLI.'
    : 'NOTE: VISUALS ABOVE ARE INTERACTIVE CONCEPT PREVIEWS, NOT FINAL PRODUCT SCREENSHOTS.',
  secGhEyebrow: '02 / LIVE REPOSITORY TELEMETRY',
  secGhTitle: isId ? 'Aktivitas & Sinkronisasi GitHub' : 'GitHub Activity & Sync',
  secGhLead: isId
    ? 'Data diambil otomatis saat build dari profil GitHub Snowsant1999 (F6 PRD).'
    : 'Automatically synced at build time from the Snowsant1999 GitHub profile (PRD F6).',
  sec2Eyebrow: '03 / ABOUT',
  sec2Title: isId ? 'Tentang saya' : 'About me',
  sec2Lead: isId
    ? 'Belajar dengan membangun, bereksperimen, dan terus mengembangkan kemampuan.'
    : 'Learning by building, experimenting, and continuously expanding engineering skills.',
  aboutP1: isId
    ? 'Saya adalah developer yang tertarik pada proses merancang dan membangun solusi digital. Portofolio ini merangkum eksplorasi saya di beberapa bidang pengembangan perangkat lunak melalui repositori GitHub.'
    : 'I am a software developer focused on designing and building practical digital systems. This portfolio summarizes my exploration across software engineering domains through public GitHub repositories.',
  aboutP2: isId
    ? 'Mulai dari aplikasi web dan desktop hingga AI, blockchain, dan cloud computing, setiap proyek menjadi ruang untuk memahami teknologi sekaligus melatih pemecahan masalah.'
    : 'From web and desktop applications to AI, blockchain, and cloud computing, every project serves as a hands-on space to understand architecture and solve concrete problems.',
  exploreGithub: isId ? 'Jelajahi GitHub saya' : 'Explore my GitHub',
  skillHead: 'Tech stack',
  skillSub: isId ? 'KLIK UNTUK FILTER PROYEK' : 'CLICK TO FILTER PROJECTS',
  sec3Eyebrow: '04 / GET IN TOUCH',
  sec3TitleBefore: isId ? 'Mari mulai' : 'Let us start a',
  sec3TitleAccent: isId ? 'percakapan.' : 'conversation.',
  contactLead: isId
    ? 'Punya pertanyaan, ide proyek, atau peluang kolaborasi? Saya terbuka untuk terhubung.'
    : 'Have a question, project idea, or collaboration opportunity? I am open to connect.',
  emailNote: isId
    ? 'EMAIL: BELUM DICANTUMKAN (PLACEHOLDER: snowsant1999@example.com). TAMBAHKAN ALAMAT PUBLIK SEBELUM RILIS.'
    : 'EMAIL: NOT YET PUBLISHED (PLACEHOLDER: snowsant1999@example.com). ADD PUBLIC ADDRESS BEFORE RELEASE.',
  copyEmailBtn: isId ? 'Salin Email Placeholder' : 'Copy Placeholder Email',
  formTitle: isId ? 'Kirim pesan' : 'Send a message',
  formName: isId ? 'Nama' : 'Name',
  formNamePh: isId ? 'Nama kamu' : 'Your name',
  formEmail: 'Email',
  formEmailPh: isId ? 'nama@email.com' : 'email@example.com',
  formMsg: isId ? 'Pesan' : 'Message',
  formMsgPh: isId
    ? 'Ceritakan apa yang ingin kamu diskusikan...'
    : 'Tell me what you would like to discuss...',
  formSubmit: isId ? 'Kirim pesan' : 'Send message',
  formDefaultNotice: isId
    ? 'Formulir ini terhubung ke endpoint Web3Forms (mode demonstrasi hingga kunci akses publik diisi).'
    : 'This form is wired to Web3Forms (running in demo simulation mode until a public access key is configured).',
};
const wl = {
  kicker: isId ? 'SEMAKIN ANEH DAN AJAIB · 2026' : 'CURIOUSER AND CURIOUSER · 2026',
  h1Before: isId ? 'Ikuti kode masuk ke ' : 'Follow the code down the ',
  h1Accent: isId ? 'lubang kelinci.' : 'rabbit hole.',
  heroLead: isId
    ? 'Enam repositori, lima dunia, satu developer yang penasaran. Jangan terlambat seperti Kelinci Putih: kontak cukup satu klik dari sini.'
    : 'Six repositories, five realms, one curious developer. Do not be late like the White Rabbit: contact is one click away.',
  sec1Title: isId ? 'Enam hal mustahil sebelum sarapan' : 'Six impossible things before breakfast',
  secGhTitle: isId ? 'Catatan dari pesta teh gila' : 'Notes from the mad tea party',
  sec2Title: isId ? 'Siapa kamu? Pertanyaan bagus.' : 'Who are you? A fair question.',
  sec3TitleBefore: isId ? 'Kirim kabar lewat' : 'Send word through the',
  sec3TitleAccent: isId ? 'cermin ajaib.' : 'looking glass.',
};

const cardSuits = ['\u2660', '\u2665', '\u2666', '\u2663'];
const cardRanks = ['A', '2', '3', '4', '5', '6'];
---

<div class="wrap">
  <section class="hero">
    <div>
      <div class="kicker">
        <span class="t-normal">{copy.kicker}</span>
        <span class="t-wl">{wl.kicker}</span>
      </div>
      <h1 class="font-display">
        <span class="t-normal">{copy.h1Before}<span class="h1-accent">{copy.h1Accent}</span></span>
        <span class="t-wl">{wl.h1Before}<span class="h1-accent">{wl.h1Accent}</span></span>
      </h1>
      <p class="hero-lead">
        <span class="t-normal">{copy.heroLead}</span>
        <span class="t-wl">{wl.heroLead}</span>
      </p>
      <div class="actions">
        <a class="btn primary" href="#projects">
          <span>{copy.ctaProjects}</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a class="btn secondary" href="#contact">
          <span>{copy.ctaContact}</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a class="btn ghost font-mono-code" href={withBase('/cv/Snowsant1999-CV-Placeholder.txt')} download>
          <span>{copy.ctaCv}</span>
        </a>
      </div>
      <div class="hero-meta">
        <div>
          <strong>06</strong>
          <span>{copy.metaRepos}</span>
        </div>
        <div>
          <strong>05</strong>
          <span>{copy.metaAreas}</span>
        </div>
        <div>
          <strong>0{gh.publicReposCount}</strong>
          <span>{copy.metaGithub}</span>
        </div>
      </div>
    </div>

    <aside class="profilecard" aria-label={isId ? 'Kartu profil Snowsant1999' : 'Snowsant1999 profile card'}>
      <div class="cardtop">
        <div class="identity">
          <div class="avatar" aria-hidden="true">S</div>
          <div>
            <strong>Snowsant1999</strong>
            <small>{copy.profileSub}</small>
          </div>
        </div>
        <span
          class="status"
          data-status-badge
          data-default-text={copy.statusLabel}
          data-wonderland-text="IN WONDERLAND ♠"
          title={isId ? 'Sedang aktif membangun repositori' : 'Actively building repositories'}
        >
          {copy.statusLabel}
        </span>
      </div>

      <div class="profilebody">
        <div class="profile-tabs" role="tablist" aria-label={isId ? 'Tampilan kartu profil' : 'Profile card view'}>
          <button
            type="button"
            role="tab"
            id="tab-btn-readme"
            aria-selected="true"
            aria-controls="tab-panel-readme"
            class="profile-tab active font-mono-code"
            data-profile-tab="readme"
          >
            {copy.tabReadme}
          </button>
          <button
            type="button"
            role="tab"
            id="tab-btn-crystal"
            aria-selected="false"
            aria-controls="tab-panel-crystal"
            class="profile-tab font-mono-code"
            data-profile-tab="crystal"
          >
            {copy.tabCrystal}
          </button>
        </div>

        <div id="tab-panel-readme" role="tabpanel" aria-labelledby="tab-btn-readme">
          <pre class="codebox t-normal"><code><span class="code-kw">const</span> profile = &#123;
  name: <em>"Snowsant1999"</em>,
  interests: [
    <em>"Web Development"</em>,
    <em>"Artificial Intelligence"</em>,
    <em>"Desktop Apps"</em>,
    <em>"Blockchain &amp; Cloud"</em>
  ],
  mindset: <em>"learn by building"</em>
&#125;</code></pre>
          <pre class="codebox t-wl"><code><span class="code-kw">const</span> wonderland = &#123;
  rabbitHole: <em>"six repositories deep"</em>,
  teaTime: <em>"always six o'clock"</em>,
  rule: <em>"curiouser and curiouser"</em>
&#125;</code></pre>
        </div>

        <div id="tab-panel-crystal" role="tabpanel" aria-labelledby="tab-btn-crystal" hidden>
          <div class="crystal-panel">
            <button
              type="button"
              class="crystal-poke"
              data-fx-poke
              aria-label={isId
                ? 'Putar kristal dan lepaskan serpihan salju (kartu remi di tema Wonderland)'
                : 'Spin the crystal and release snowflakes (playing cards in Wonderland)'}
            >
              <span class="crystal-spin">
                <Crystal name="Snowsant1999" language="Python" size={168} />
              </span>
            </button>
            <p class="font-mono-code crystal-note">
              seed: "Snowsant1999" · 6-fold SVG
            </p>
          </div>
        </div>
      </div>

      <div class="profilefoot">
        <span class="mono">GITHUB / PROFILE</span>
        <a href="https://github.com/Snowsant1999" target="_blank" rel="noopener noreferrer" class="profile-gh-link">
          {copy.viewGithub}
        </a>
      </div>
    </aside>
  </section>

  <section class="section" id="projects" data-reveal>
    <div class="sectionhead">
      <div>
        <div class="eyebrow">{copy.sec1Eyebrow}</div>
        <h2 class="font-display">
          <span class="t-normal">{copy.sec1Title}</span>
          <span class="t-wl">{wl.sec1Title}</span>
        </h2>
      </div>
      <p class="sectionlead">{copy.sec1Lead}</p>
    </div>

    <div class="filters" role="group" aria-label={isId ? 'Filter kategori proyek' : 'Filter project category'}>
      <button type="button" class="filter active" data-filter="all" aria-pressed="true">
        {copy.filterAll} <span>06</span>
      </button>
      <button type="button" class="filter" data-filter="web" aria-pressed="false">
        Web <span>02</span>
      </button>
      <button type="button" class="filter" data-filter="ai" aria-pressed="false">
        AI <span>01</span>
      </button>
      <button type="button" class="filter" data-filter="desktop" aria-pressed="false">
        Desktop <span>01</span>
      </button>
      <button type="button" class="filter" data-filter="cloud" aria-pressed="false">
        Cloud <span>01</span>
      </button>
      <button type="button" class="filter" data-filter="blockchain" aria-pressed="false">
        Blockchain <span>01</span>
      </button>
    </div>
    <p id="filter-live-status" class="sr-only" role="status" aria-live="polite"></p>

    <div class="projects">
      {projects.map((entry) => {
        const p = entry.data;
        const detailHref = withBase(`${projectBase}${p.slug}`);
        const numStr = `0${p.order} / 06`;
        const cardCode = `${cardRanks[p.order - 1]}${cardSuits[(p.order - 1) % 4]}`;
        const liveRepo = gh.repos[p.repoName];
        const stars = liveRepo?.stargazersCount ?? 0;

        return (
          <article class="project" data-category={p.category} data-reveal style={`--i:${p.order - 1}`}>
            {p.slug === 'alice-ai' && (
              <div class="projectvisual ai">
                <div class="visualbar">
                  <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span class="visual-filename">alice_ai.py · scripted demo</span>
                </div>
                <div class="chatui" id="alice-chat-log" aria-live="polite">
                  <div class="bubble user" id="alice-user-msg">Hi, Alice!</div>
                  <div class="bubble bot" id="alice-bot-reply">
                    {isId
                      ? 'Halo! Klik topik atau ketik pertanyaan tentang proyek Snowsant1999.'
                      : 'Hello! Click a prompt or type a question about Snowsant1999 projects.'}
                  </div>
                </div>
                <div class="chat-prompts" role="group" aria-label={isId ? 'Pertanyaan cepat Alice' : 'Alice quick prompts'}>
                  {aliceIntents.slice(0, 3).map((intent) => (
                    <button
                      type="button"
                      class="chat-chip"
                      data-alice-chip={intent.chip[locale]}
                      data-alice-ask={intent.answer[locale]}
                    >
                      {intent.chip[locale]}
                    </button>
                  ))}
                  <button
                    type="button"
                    class="chat-chip wonderland-chip"
                    data-wonderland-toggle
                    aria-pressed="false"
                  >
                    {isId ? '♠ Lubang Kelinci (On/Off)' : '♠ Rabbit Hole (On/Off)'}
                  </button>
                </div>
                <form class="alice-inline-form" id="alice-inline-form">
                  <label for="alice-inline-input" class="sr-only">
                    {isId ? 'Tanya Alice' : 'Ask Alice'}
                  </label>
                  <input
                    id="alice-inline-input"
                    type="text"
                    placeholder={isId ? 'Tanya stack, POS, Laravel...' : 'Ask about stack, POS, Laravel...'}
                    autocomplete="off"
                  />
                  <button type="submit" class="alice-send-btn font-mono-code">
                    {isId ? 'Tanya' : 'Ask'}
                  </button>
                </form>
              </div>
            )}

            {p.slug === 'website-keluhan-siswa' && (
              <div class="projectvisual web">
                <div class="browser">
                  <div class="browserbar">
                    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="visual-filename">student-complaint.app</span>
                  </div>
                  <div class="webmock">
                    <div class="mocknav">Portal Keluhan Siswa</div>
                    <div class="mocktitle">
                      Sampaikan aspirasi<br /><b>lebih mudah.</b>
                    </div>
                    <div class="mockline"></div>
                    <span class="mockbutton">Buat pengaduan</span>
                  </div>
                </div>
              </div>
            )}

            {p.slug === 'my-restaurant' && (
              <div class="projectvisual restaurant">
                <div class="restmock">
                  <div class="restlabel">MY RESTAURANT</div>
                  <div class="resttitle">
                    Good food.<br />Good moments.
                  </div>
                  <div class="restdish" aria-hidden="true"></div>
                  <div class="restline">EXPLORE OUR MENU</div>
                </div>
              </div>
            )}

            {p.slug === 'pos-amplang' && (
              <div class="projectvisual pos">
                <div class="poswindow">
                  <div class="poshead">
                    POS AMPLANG <span aria-hidden="true">● ● ●</span>
                  </div>
                  <div class="posbody">
                    <div class="posmenu" aria-hidden="true">
                      <i></i><i></i><i></i><i></i>
                    </div>
                    <div class="posreceipt">
                      <b>Ringkasan transaksi</b>
                      <hr />
                      <span>Amplang Original</span>
                      <strong>Rp 25.000</strong>
                      <span>Amplang Pedas</span>
                      <strong>Rp 30.000</strong>
                      <hr />
                      <b>Total Rp 55.000</b>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {p.slug === 'cc-roadmap' && (
              <div class="projectvisual cloud">
                <div class="cloudcard">
                  <div class="mono">CLOUD COMPUTING</div>
                  <div class="cloudnodes">
                    <span>DEV</span>
                    <b aria-hidden="true">→</b>
                    <span>BUILD</span>
                    <b aria-hidden="true">→</b>
                    <span>DEPLOY</span>
                  </div>
                  <div class="cloudbase">CC / ROADMAP</div>
                </div>
              </div>
            )}

            {p.slug === 'praktikum-blockchain' && (
              <div class="projectvisual chain">
                <div class="chainvisual">
                  <div class="chaincube" aria-hidden="true">◇</div>
                  <div class="chainlines">
                    <span>SMART CONTRACT</span>
                    <span>TRANSACTION</span>
                    <span>BLOCK / 001</span>
                  </div>
                  <div class="chainstamp">SOLIDITY</div>
                </div>
              </div>
            )}

            <div class="projectinfo">
              <div class="projectmeta">
                <span class="eyebrow">
                  {p.categoryLabel} {stars > 0 ? `· ★ ${stars}` : ''}
                </span>
                <span class="mono t-normal">{numStr}</span>
                <span class="mono card-code t-wl">{cardCode}</span>
              </div>

              <div class="project-title-row">
                <h3 transition:name={`title-${p.slug}`}>
                  <a href={detailHref} class="card-title-link">{p.title}</a>
                </h3>
                <div transition:name={`crystal-${p.slug}`} class="mini-crystal">
                  <Crystal name={p.repoName} language={p.primaryLanguage} size={28} />
                </div>
              </div>

              <p>{p.summary[locale]}</p>

              <div class="tags">
                {p.stack.slice(0, 3).map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>

              <div class="card-footer-links">
                <a class="repo-detail-link" href={detailHref}>
                  <span>{copy.openDetail}</span>
                  <b aria-hidden="true">→</b>
                </a>
                <a class="repo" href={p.repoUrl} target="_blank" rel="noopener noreferrer">
                  <span>{copy.openRepo}</span>
                  <b aria-hidden="true">↗</b>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <p class="projectnote mono">{copy.visualNote}</p>
  </section>

  <!-- I5: Live GitHub Telemetry & Recent Repository Updates -->
  <section class="section" id="github-activity" data-reveal>
    <div class="sectionhead">
      <div>
        <div class="eyebrow">{copy.secGhEyebrow}</div>
        <h2 class="font-display">
          <span class="t-normal">{copy.secGhTitle}</span>
          <span class="t-wl">{wl.secGhTitle}</span>
        </h2>
      </div>
      <p class="sectionlead">{copy.secGhLead}</p>
    </div>

    <div class="gh-telemetry-grid">
      <div class="gh-summary-card">
        <div class="gh-stat-row">
          <div>
            <span class="mono">{isId ? 'REPOSITORI PUBLIK' : 'PUBLIC REPOS'}</span>
            <strong class="font-display">{gh.publicReposCount}</strong>
          </div>
          <div>
            <span class="mono">{isId ? 'PENGIKUT' : 'FOLLOWERS'}</span>
            <strong class="font-display">{gh.followersCount}</strong>
          </div>
          <div>
            <span class="mono">{isId ? 'BINTANG' : 'TOTAL STARS'}</span>
            <strong class="font-display">{gh.totalStars}</strong>
          </div>
        </div>
        <p class="gh-sync-note font-mono-code">
          source: {gh.source} · snapshot: {gh.fetchedAt.slice(0, 10)}
        </p>
      </div>

      <div class="gh-commits-card">
        <div class="skillhead">
          <strong>{isId ? 'Pembaruan Repositori Terakhir' : 'Latest Repository Updates'}</strong>
          <span class="mono">GITHUB REST API</span>
        </div>
        <ul class="commit-list">
          {gh.recentCommits.slice(0, 3).map((c) => (
            <li>
              <a href={c.url} target="_blank" rel="noopener noreferrer" class="commit-row">
                <span class="commit-repo font-mono-code">{c.repoName}</span>
                <span class="commit-msg">{c.message}</span>
                <span class="commit-date font-mono-code">{c.date}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="about" data-reveal>
    <div class="sectionhead">
      <div>
        <div class="eyebrow">{copy.sec2Eyebrow}</div>
        <h2 class="font-display">
          <span class="t-normal">{copy.sec2Title}</span>
          <span class="t-wl">{wl.sec2Title}</span>
        </h2>
      </div>
      <p class="sectionlead">{copy.sec2Lead}</p>
    </div>

    <div class="aboutgrid">
      <div class="aboutcopy">
        <p>{copy.aboutP1}</p>
        <p>{copy.aboutP2}</p>
        <a class="textlink" href="https://github.com/Snowsant1999" target="_blank" rel="noopener noreferrer">
          <span>{copy.exploreGithub}</span>
          <b aria-hidden="true">↗</b>
        </a>
      </div>

      <div class="skillpanel" id="stack">
        <div class="skillhead">
          <strong>{copy.skillHead}</strong>
          <span class="mono">{copy.skillSub}</span>
        </div>

        <button type="button" class="skillrow" data-skill-jump="web">
          <span class="skilldot">P</span>
          <span class="skillrow-text">
            <b>PHP · Laravel 11</b>
            <small>Web development (2 repos)</small>
          </span>
          <span class="skilltag">WEB</span>
        </button>

        <button type="button" class="skillrow" data-skill-jump="desktop">
          <span class="skilldot">J</span>
          <span class="skillrow-text">
            <b>Java</b>
            <small>Desktop applications (1 repo)</small>
          </span>
          <span class="skilltag">DESKTOP</span>
        </button>

        <button type="button" class="skillrow" data-skill-jump="ai">
          <span class="skilldot">Py</span>
          <span class="skillrow-text">
            <b>Python</b>
            <small>Artificial intelligence (1 repo)</small>
          </span>
          <span class="skilltag">AI</span>
        </button>

        <button type="button" class="skillrow" data-skill-jump="cloud">
          <span class="skilldot">JS</span>
          <span class="skillrow-text">
            <b>JavaScript</b>
            <small>Cloud computing roadmap (1 repo)</small>
          </span>
          <span class="skilltag">CLOUD</span>
        </button>

        <button type="button" class="skillrow" data-skill-jump="blockchain">
